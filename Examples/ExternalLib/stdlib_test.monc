#external "stdlib.h"{
    playCodeC {
        void srand(unsigned int seed);
        int rand(void);
        int atoi(const char* str);
    }
}

fn main[] -> Int32 {
    srand(123);
    print[rand()];

    srand(456);
    print[rand()];

    srand(719);
    print[rand()];
    
    let code: Char[] = "11221";

    let NumCode: Int32 = atoi(code);

    print[NumCode];

    return 0;
}