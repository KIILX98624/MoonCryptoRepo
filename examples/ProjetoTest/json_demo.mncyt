// MoonCrypto - demonstracao proposta do modulo JSON
//
// STATUS: exemplo de API futura, NAO EXECUTAVEL no prototipo atual.
// Requer a implementacao de `use json`, `JsonValue`, json.read,
// json.write, json.get e json.stringify conforme JSON_MODULE.md.
//
// Entrada esperada (criada, por exemplo, pelo Python):
// {
//     "n1": 10.5,
//     "n2": 5.5
// }

use json

fn main[] -> Int32 {
    // Le o arquivo JSON produzido pelo programa Python.
    let dados: JsonValue = json.read["conversor.json"];

    // Recupera os valores como JsonValue.
    let n1: JsonValue = json.get[dados, "n1"];
    let n2: JsonValue = json.get[dados, "n2"];

    // Serializa os valores para exibi-los sem exigir Float64
    // enquanto esse tipo ainda nao estiver confirmado no HoldMap.
    print["n1 = " + json.stringify[n1]];
    print["n2 = " + json.stringify[n2]];

    // Grava uma copia do objeto em outro arquivo JSON.
    json.write["copia_conversor.json", dados];

    print["Arquivo JSON copiado com sucesso!"];
    return 0;
}
