// ==========================================
// Módulo de Matemática MoonCrypto (math.mncyt)
// ==========================================

// --- Operações Aritméticas Básicas ---

fn sum[num1: Int32, num2: Int32] -> Int32 {
    return num1 + num2;
}

fn subtract[num1: Int32, num2: Int32] -> Int32 {
    return num1 - num2;
}

fn multiply[num1: Int32, num2: Int32] -> Int32 {
    return num1 * num2;
}

fn divide[num1: Int32, num2: Int32] -> Int32 {
    if (num2 == 0) {
        return 0;
    }
    return num1 / num2;
}

fn modulo[num1: Int32, num2: Int32] -> Int32 {
    if (num2 == 0) {
        return 0;
    }
    return num1 % num2;
}

fn power[base: Int32, exp: Int32] -> Int32 {
    let res: Int32 = 1;
    let e: Int32 = exp;
    while [e > 0] {
        res = res * base;
        e = e - 1;
    }
    return res;
}

// --- Funções Clássicas e Teoria dos Números ---

fn factorial[num: Int32] -> Int32 {
    if (num <= 1) {
        return 1;
    }
    return num * factorial[num - 1];
}

fn fibonacci[num: Int32] -> Int32 {
    if (num <= 0) {
        return 0;
    }
    if (num == 1) {
        return 1;
    }
    return fibonacci[num - 1] + fibonacci[num - 2];
}

fn gcd[num1: Int32, num2: Int32] -> Int32 {
    let a: Int32 = num1;
    let b: Int32 = num2;
    while [b != 0] {
        let temp: Int32 = b;
        b = a % b;
        a = temp;
    }
    return a;
}

fn lcm[num1: Int32, num2: Int32] -> Int32 {
    let divisor: Int32 = gcd[num1, num2];
    if (divisor == 0) {
        return 0;
    }
    return (num1 * num2) / divisor;
}

// --- Predicados e Testes Numéricos (1 = Verdadeiro, 0 = Falso) ---

fn is_even[num: Int32] -> Int32 {
    if (num % 2 == 0) {
        return 1;
    }
    return 0;
}

fn is_odd[num: Int32] -> Int32 {
    if (num % 2 != 0) {
        return 1;
    }
    return 0;
}

fn is_prime[num: Int32] -> Int32 {
    if (num <= 1) {
        return 0;
    }
    let i: Int32 = 2;
    while [i * i <= num] {
        if (num % i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn is_perfect_square[num: Int32] -> Int32 {
    if (num < 0) {
        return 0;
    }
    let i: Int32 = 0;
    while [i * i <= num] {
        if (i * i == num) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn is_perfect_cube[num: Int32] -> Int32 {
    let i: Int32 = 0;
    while [i * i * i <= num] {
        if (i * i * i == num) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn is_palindrome[num: Int32] -> Int32 {
    if (num < 0) {
        return 0;
    }
    let rev: Int32 = 0;
    let n: Int32 = num;
    while [n > 0] {
        rev = (rev * 10) + (n % 10);
        n = n / 10;
    }
    if (rev == num) {
        return 1;
    }
    return 0;
}

fn is_armstrong[num: Int32] -> Int32 {
    if (num < 0) {
        return 0;
    }
    // Contar dígitos
    let digits: Int32 = 0;
    let temp: Int32 = num;
    while [temp > 0] {
        digits = digits + 1;
        temp = temp / 10;
    }
    // Somar dígitos elevados à quantidade de dígitos
    let sum: Int32 = 0;
    temp = num;
    while [temp > 0] {
        let d: Int32 = temp % 10;
        sum = sum + power[d, digits];
        temp = temp / 10;
    }
    if (sum == num) {
        return 1;
    }
    return 0;
}

fn is_perfect_number[num: Int32] -> Int32 {
    if (num <= 1) {
        return 0;
    }
    let sum: Int32 = 0;
    let i: Int32 = 1;
    while [i <= num / 2] {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }
    if (sum == num) {
        return 1;
    }
    return 0;
}

fn is_abundant_number[num: Int32] -> Int32 {
    if (num <= 1) {
        return 0;
    }
    let sum: Int32 = 0;
    let i: Int32 = 1;
    while [i <= num / 2] {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }
    if (sum > num) {
        return 1;
    }
    return 0;
}

fn is_deficient_number[num: Int32] -> Int32 {
    if (num <= 1) {
        return 1;
    }
    let sum: Int32 = 0;
    let i: Int32 = 1;
    while [i <= num / 2] {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }
    if (sum < num) {
        return 1;
    }
    return 0;
}

fn is_harshad_number[num: Int32] -> Int32 {
    if (num <= 0) {
        return 0;
    }
    let sum: Int32 = 0;
    let temp: Int32 = num;
    while [temp > 0] {
        sum = sum + (temp % 10);
        temp = temp / 10;
    }
    if (num % sum == 0) {
        return 1;
    }
    return 0;
}

fn is_twin_prime[num: Int32] -> Int32 {
    if (is_prime[num] == 0) {
        return 0;
    }
    if (is_prime[num - 2] == 1) {
        return 1;
    }
    if (is_prime[num + 2] == 1) {
        return 1;
    }
    return 0;
}

fn is_emirp[num: Int32] -> Int32 {
    if (is_prime[num] == 0) {
        return 0;
    }
    let rev: Int32 = 0;
    let n: Int32 = num;
    while [n > 0] {
        rev = (rev * 10) + (n % 10);
        n = n / 10;
    }
    if (rev == num) {
        return 0;
    }
    return is_prime[rev];
}
