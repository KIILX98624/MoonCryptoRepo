#external "json"

fn main[] -> Int32 {
    let texto: String32 = "{\"nome\":\"MoonCrypto\",\"versao\":2,\"ativo\":true}";
    let documento: JsonValue = json.parse[texto];

    let nome: String32 = json.get[documento, "nome"].as_string[];
    let versao: Int32 = json.get[documento, "versao"].as_int[];
    if (json.has[documento, "ativo"]) {
        print["json-active=true"];
    }

    let lista: JsonValue = json.new_array[];
    json.push[lista, json.from_int[7]];
    json.push[lista, json.from_int[9]];

    let objeto: JsonValue = json.new_object[];
    json.set[objeto, "nome", json.from_string[nome]];
    json.set[objeto, "versao", json.from_int[versao]];
    json.set[objeto, "lista", lista];

    print["json-name=" + nome];
    print["json-version=" + versao];
    print["json-array=" + json.stringify[lista]];
    print["json-object=" + json.stringify[objeto]];
    return 0;
}
