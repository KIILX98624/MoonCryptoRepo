#external "math.h" {
    playCodeC {
        double sqrt(double value);
        double pow(double base, double exponent);
        double sin(double value);
    }
}

#external "stdlib.h" {
    playCodeC {
        int abs(int value);
        int atoi(char* text);
        int rand(void);
    }
}

fn main[] -> Int32 {
    let root: Float64 = sqrt(25.0);
    let power: Float64 = pow(2.0, 5.0);
    let wave: Float64 = sin(0.0);
    let absolute: Int32 = abs(-17);
    let parsed: Int32 = atoi("123");
    let random_value: Int32 = rand();

    print["sqrt=" + root];
    print["pow=" + power];
    print["sin=" + wave];
    print["abs=" + absolute];
    print["atoi=" + parsed];
    print["rand=called"];
    return 0;
}
