{
  "name": "monc-language",
  "displayName": "MonC Language Support",
  "description": "Syntax highlighting and snippets for Monc (.monc) source files.",
  "version": "1.5.5",
  "publisher": "monc-project",
  "icon": "monc-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "monc",
        "aliases": [
          "MonC",
          "MonC",
          "monc"
        ],
        "extensions": [
          ".monc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "monc",
        "scopeName": "source.monc",
        "path": "./syntaxes/monc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "monc",
        "path": "./snippets/monc.code-snippets"
      }
    ]
  }
}
