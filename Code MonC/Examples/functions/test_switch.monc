// Example: Demonstrates switch statements with integer and string values, including a default branch.

// Runs the example and demonstrates the feature described in the file header.

fn main[] -> Int32 {
    let dia: Int32 = 3;

    print["=== Switch com Int32 ==="];
    switch [dia] {
        case 1 {
            print["Segunda-feira"];
        }
        case 2 {
            print["Terca-feira"];
        }
        case 3 {
            print["Quarta-feira"];
        }
        case 4 {
            print["Quinta-feira"];
        }
        case 5 {
            print["Sexta-feira"];
        }
        default {
            print["Final de semana!"];
        }
    }

    print["=== Switch com String64 ==="];
    let lang: String64 = "MoonCrypto";

    switch [lang] {
        case "Python" {
            print["Voce escolheu Python"];
        }
        case "MoonCrypto" {
            print["Voce escolheu MoonCrypto! Boa escolha!"];
        }
        default {
            print["Linguagem desconhecida"];
        }
    }

    print["=== Switch com default ==="];
    let x: Int32 = 99;
    switch [x] {
        case 1 {
            print["um"];
        }
        case 2 {
            print["dois"];
        }
        default {
            print["nenhum dos anteriores, x = " + x];
        }
    }

    return 0;
}
