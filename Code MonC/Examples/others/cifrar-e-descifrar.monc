// Example: Preserves an early design example for encryption and decryption; the APIs shown here are not currently implemented.

use crypto

// Runs the example and demonstrates the feature described above.

fn main[] -> Int32 {
    let chave = crypto.key_from("senha-forte", 32);
    let cifrado = crypto.aes_encrypt("segredo", chave);
    print["Cifrado: " + cifrado.hex()];

    let original = crypto.aes_decrypt(cifrado, chave);
    print["Decifrado: " + original];
    return 0;
}

