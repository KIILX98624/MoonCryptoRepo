// Example: Demonstrates declaring a constant, printing a greeting, and hashing text with the crypto module.

use crypto

// Runs the example and demonstrates the feature described above.

fn main[] -> Int32 {
    const nome: String32 = "Lua";
    print["Olá, " + nome + "!"];
    print[crypto.sha256[nome]];// mesma coisa que que o com .hex[]
    print[crypto.sha256[nome].hex[]];
    return 0;
}