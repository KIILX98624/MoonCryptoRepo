// Example: Demonstrates calculating a SHA-256 digest and displaying it as hexadecimal text.

use crypto

// Runs the example and demonstrates the feature described above.

fn main[] -> Int32 {
    let texto: String32 = "MoonCrypto";
    let h = crypto.sha256[texto];
    print["SHA-256: " + h.hex[]];
    return 0;
}

//ok