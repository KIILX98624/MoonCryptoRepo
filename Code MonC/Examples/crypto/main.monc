// Example: Demonstrates hashing a text value with SHA-256 and printing both the input and digest.

use crypto

// Runs the example and demonstrates the feature described in the file header.

fn main[] -> Int32 {
    let texto: String32 = "Gustavo";
    let h = crypto.sha256[texto];
    print["Texto: " + texto];
    print["SHA-256: " + h.hex[]];
    return 0;
}
