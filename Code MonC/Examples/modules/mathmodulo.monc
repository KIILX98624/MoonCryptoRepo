// Example: Provides reusable arithmetic and number-property functions for the module example.

// ==========================================
// MoonCrypto mathematics module (math.mncyt)
// ==========================================

// --- Basic arithmetic operations ---

// Adds two integers and returns the result.

fn sum[num1: Int32, num2: Int32] -> Int32 {
    return num1 + num2;
}

// Subtracts the second integer from the first.

fn subtract[num1: Int32, num2: Int32] -> Int32 {
    return num1 - num2;
}

// Multiplies two integers and returns the product.

fn multiply[num1: Int32, num2: Int32] -> Int32 {
    return num1 * num2;
}

// Divides the first integer by the second, returning zero when the divisor is zero in this example.

fn divide[num1: Int32, num2: Int32] -> Int32 {
    if (num2 == 0) {
        return 0;
    }
    return num1 / num2;
}

// Returns the remainder of integer division, or zero when the divisor is zero in this example.

fn modulo[num1: Int32, num2: Int32] -> Int32 {
    if (num2 == 0) {
        return 0;
    }
    return num1 % num2;
}

// Raises an integer base to a non-negative integer exponent using repeated multiplication.

fn power[base: Int32, exp: Int32] -> Int32 {
    let res: Int32 = 1;
    let e: Int32 = exp;
    while [e > 0] {
        res = res * base;
        e = e - 1;
    }
    return res;
}

// --- Classic functions and number theory ---

// Calculates the factorial of a non-negative integer recursively.

fn factorial[num: Int32] -> Int32 {
    if (num <= 1) {
        return 1;
    }
    return num * factorial[num - 1];
}

// Returns the Fibonacci number at the requested position using recursion.

fn fibonacci[num: Int32] -> Int32 {
    if (num <= 0) {
        return 0;
    }
    if (num == 1) {
        return 1;
    }
    return fibonacci[num - 1] + fibonacci[num - 2];
}

// Calculates the greatest common divisor using the Euclidean algorithm.

fn gcd[num1: Int32, num2: Int32] -> Int32 {
    let a: Int32 = num1;
    let b: Int32 = num2;
    while [b != 0] {
        let temp: Int32 = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// Calculates the least common multiple using the greatest common divisor.

fn lcm[num1: Int32, num2: Int32] -> Int32 {
    let divisor: Int32 = gcd[num1, num2];
    if (divisor == 0) {
        return 0;
    }
    return (num1 * num2) / divisor;
}

// --- Number predicates and tests (1 = true, 0 = false) ---

// Returns 1 when the number is even, or 0 otherwise.

fn is_even[num: Int32] -> Int32 {
    if (num % 2 == 0) {
        return 1;
    }
    return 0;
}

// Returns 1 when the number is odd, or 0 otherwise.

fn is_odd[num: Int32] -> Int32 {
    if (num % 2 != 0) {
        return 1;
    }
    return 0;
}

// Checks whether the supplied integer is a prime number.

fn is_prime[num: Int32] -> Int32 {
    if (num <= 1) {
        return 0;
    }
    let i: Int32 = 2;
    while [i * i <= num] {
        if (num % i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// Checks whether the supplied non-negative integer is a perfect square.

fn is_perfect_square[num: Int32] -> Int32 {
    if (num < 0) {
        return 0;
    }
    let i: Int32 = 0;
    while [i * i <= num] {
        if (i * i == num) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Checks whether the supplied integer is a perfect cube.

fn is_perfect_cube[num: Int32] -> Int32 {
    let i: Int32 = 0;
    while [i * i * i <= num] {
        if (i * i * i == num) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Checks whether the decimal digits of the supplied integer read the same in reverse.

fn is_palindrome[num: Int32] -> Int32 {
    if (num < 0) {
        return 0;
    }
    let rev: Int32 = 0;
    let n: Int32 = num;
    while [n > 0] {
        rev = (rev * 10) + (n % 10);
        n = n / 10;
    }
    if (rev == num) {
        return 1;
    }
    return 0;
}

// Checks whether the number equals the sum of its digits raised to the number of digits.

fn is_armstrong[num: Int32] -> Int32 {
    if (num < 0) {
        return 0;
    }
    // Count the number of digits.
    let digits: Int32 = 0;
    let temp: Int32 = num;
    while [temp > 0] {
        digits = digits + 1;
        temp = temp / 10;
    }
    // Add each digit raised to the number of digits.
    let sum: Int32 = 0;
    temp = num;
    while [temp > 0] {
        let d: Int32 = temp % 10;
        sum = sum + power[d, digits];
        temp = temp / 10;
    }
    if (sum == num) {
        return 1;
    }
    return 0;
}

// Checks whether the sum of the positive proper divisors equals the number.

fn is_perfect_number[num: Int32] -> Int32 {
    if (num <= 1) {
        return 0;
    }
    let sum: Int32 = 0;
    let i: Int32 = 1;
    while [i <= num / 2] {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }
    if (sum == num) {
        return 1;
    }
    return 0;
}

// Checks whether the sum of the positive proper divisors is greater than the number.

fn is_abundant_number[num: Int32] -> Int32 {
    if (num <= 1) {
        return 0;
    }
    let sum: Int32 = 0;
    let i: Int32 = 1;
    while [i <= num / 2] {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }
    if (sum > num) {
        return 1;
    }
    return 0;
}

// Checks whether the sum of the positive proper divisors is smaller than the number.

fn is_deficient_number[num: Int32] -> Int32 {
    if (num <= 1) {
        return 1;
    }
    let sum: Int32 = 0;
    let i: Int32 = 1;
    while [i <= num / 2] {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }
    if (sum < num) {
        return 1;
    }
    return 0;
}

// Checks whether the number is divisible by the sum of its decimal digits.

fn is_harshad_number[num: Int32] -> Int32 {
    if (num <= 0) {
        return 0;
    }
    let sum: Int32 = 0;
    let temp: Int32 = num;
    while [temp > 0] {
        sum = sum + (temp % 10);
        temp = temp / 10;
    }
    if (num % sum == 0) {
        return 1;
    }
    return 0;
}

// Checks whether the number is prime and differs by two from another prime.

fn is_twin_prime[num: Int32] -> Int32 {
    if (is_prime[num] == 0) {
        return 0;
    }
    if (is_prime[num - 2] == 1) {
        return 1;
    }
    if (is_prime[num + 2] == 1) {
        return 1;
    }
    return 0;
}

// Checks whether the number and its reversed digits are distinct prime numbers.

fn is_emirp[num: Int32] -> Int32 {
    if (is_prime[num] == 0) {
        return 0;
    }
    let rev: Int32 = 0;
    let n: Int32 = num;
    while [n > 0] {
        rev = (rev * 10) + (n % 10);
        n = n / 10;
    }
    if (rev == num) {
        return 0;
    }
    return is_prime[rev];
}
