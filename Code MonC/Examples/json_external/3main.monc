// Example: Demonstrates reading JSON data from a file, retrieving fields, and writing the JSON value to another file.

#external json

// Runs the example and demonstrates the feature described in the file header.

fn main[] -> Int32 {
    // Read the JSON file generated by the Python program.
    let dados: JsonValue = json.read["2conversor.json"];

    // Retrieve the values as JsonValue instances.
    let n1: JsonValue = json.get[dados, "n1"];
    let n2: JsonValue = json.get[dados, "n2"];

    // Serialize the values for display without requiring Float64
    // while this type is not yet confirmed in the HoldMap.
    print["n1 = " + json.stringify[n1]];
    print["n2 = " + json.stringify[n2]];

    // Write a copy of the object to another JSON file.
    json.write["4conversor.json", dados];

    print["Arquivo JSON criado com sucesso!"];
    return 0;
}
